# =============================================================================
# OpenSearch cluster kurulum ayarları
#
# Bu dosya 5 node'da ve 2 Dashboards sunucusunda AYNI olmalı. node2-5 ve
# dashboard1/2 script'leri node1'den gelen paketteki kopyayla karşılaştırır; farklıysa durur.
# Şifreler bu dosyaya yazılmaz; script'ler sorar (bkz. README).
# =============================================================================

# --- Cluster ---
CLUSTER_NAME="opensearch-cluster"
OS_VERSION="3.9.0"                        # OpenSearch ve Dashboards sürümü (RPM dosya adındaki)
NODE_ROLES="cluster_manager, data, ingest"

# --- Node'lar ---
# İsimler /etc/hosts'a yazılır; node.name ve sertifika CN'si olarak da kullanılır.
# IP'leri gerçek değerlerle değiştirin. CHANGE_ME kalırsa script'ler çalışmaz.
NODE1_NAME="node1"
NODE1_IP="CHANGE_ME"
NODE2_NAME="node2"
NODE2_IP="CHANGE_ME"
NODE3_NAME="node3"
NODE3_IP="CHANGE_ME"
NODE4_NAME="node4"
NODE4_IP="CHANGE_ME"
NODE5_NAME="node5"
NODE5_IP="CHANGE_ME"

# --- Dashboards sunucuları (OpenSearch node'larından ayrı, yedekli) ---
# İki sunucu da aynı cluster'a bağlanır ve aynı oturum anahtarını kullanır;
# üzerlerindeki HAProxy ve sanal IP ile tek adresten erişilir.
DASHBOARD1_NAME="dashboard1"
DASHBOARD1_IP="CHANGE_ME"
DASHBOARD2_NAME="dashboard2"
DASHBOARD2_IP="CHANGE_ME"

# yes: sunucunun hostname'i yukarıdaki node / dashboard adına çevrilir
SET_HOSTNAME="no"

# --- RPM paketleri ---
# Bu dizine konacak dosyalar (aarch64 sunucularda dosya adlarında x64 yerine arm64):
#   opensearch-<sürüm>-linux-x64.rpm ve .rpm.sig               5 node
#   opensearch-dashboards-<sürüm>-linux-x64.rpm ve .rpm.sig    dashboard1, dashboard2
#   opensearch-release.pgp (imza anahtarı)                     tüm sunucular
RPM_DIR="/root/opensearch-rpm"
VERIFY_RPM_SIGNATURE="yes"                # no: .sig doğrulaması atlanır (önerilmez)
GPG_KEY_FILE="${RPM_DIR}/opensearch-release.pgp"

# --- Dizinler ---
DATA_DIR="/data/opensearch"
LOG_DIR="/data/logs"
REQUIRE_DATA_MOUNT="no"                   # yes: /data ayrı bir mount değilse hazirlik.sh durur

# --- JVM ---
HEAP_SIZE="auto"                          # auto: RAM'in yarısı (en fazla 31g). Elle: "8g"

# --- Sertifikalar (yalnızca node1'de üretilir) ---
CERT_WORKDIR="/root/opensearch-certs"     # root CA key burada; kurulumdan sonra güvenli yere taşıyın
CERT_SUBJECT="/C=TR/O=Sirket/OU=IT"       # CN'leri script ekler
CA_DAYS=3650
CERT_DAYS=730
KEY_BITS=2048
ADD_CA_TO_SYSTEM_TRUST="yes"              # root CA sistem güvenine eklenir (curl'de --cacert gerekmez)

# --- node1 -> node2-5 ve dashboard1/2 paket dağıtımı ---
BUNDLE_DIR="/root/opensearch-bundle"      # node1'de paketlerin üretildiği dizin
BUNDLE_TARGET_DIR="/root"                 # diğer sunucularda paketin bekleneceği dizin
DISTRIBUTE_WITH_SCP="yes"                 # yes: node1 paketleri root@<sunucu>'ya scp ile gönderir

# --- Firewall (yalnızca firewalld çalışıyorsa uygulanır) ---
FIREWALL_ZONE=""                          # boş: sunucu IP'sinin bağlı olduğu arayüzün zone'u
HTTP_ALLOWED_SOURCES=""                   # 9200'e erişecek ek CIDR'lar (node'lar ve dashboard'lar zaten açık). Ör: "10.20.0.0/24 10.30.1.5/32"
DASHBOARDS_ALLOWED_SOURCES=""             # HAPROXY_DASHBOARDS_PORT'a erişecek CIDR'lar; boş: herkese açık
OPENSEARCH_LB_ALLOWED_SOURCES=""          # HAPROXY_OPENSEARCH_PORT'a erişecek CIDR'lar; boş: herkese açık

# --- Dashboards (dashboard1, dashboard2) ---
# Dışarıdan tek adres: https://<FQDN> Dashboards, https://<FQDN>:9200 OpenSearch (bkz. HAProxy bölümü).
# DNS kaydı HAPROXY_VIP'i gösterir. HAProxy'nin dışarıya gösterdiği sertifika da bu adı içerir.
# Zorunlu; sunucu adlarından farklı olmalı.
DASHBOARDS_FQDN="CHANGE_ME"
# auto    : DASHBOARDS_CERT_SRC içinde ssl.crt ve ssl.key varsa onları kullanır, yoksa üretir
# provided: kurum sertifikası zorunlu (ssl.crt, ssl.key, ca.crt)
# self    : cluster'ın root CA'sıyla imzalı sertifika üretilir (her dashboard sunucusuna ayrı)
DASHBOARDS_CERT_MODE="auto"
DASHBOARDS_CERT_SRC="/root/dashboards-certs"   # her dashboard sunucusunda kendi kurum sertifikası
DASHBOARDS_EXTRA_SAN=""                   # self modda iki sertifikaya da eklenecek SAN'lar. Ör: "DNS:opensearch.sirket.local,IP:10.0.0.50"

# --- HAProxy ve keepalived (dashboard1, dashboard2 üzerinde) ---
# İki sunucu aynı sanal IP'yi paylaşır; biri düşerse IP diğerine geçer. IP'nin sunucularla aynı
# subnet'te ve boş olması, ağda VRRP'ye (sunucular arası) izin verilmesi gerekir.
HAPROXY_VIP="CHANGE_ME"
HAPROXY_VRID=51                           # 1-255; aynı ağdaki başka keepalived kümeleriyle çakışmamalı
HAPROXY_DASHBOARDS_PORT=443               # -> dashboard1/2:5601
HAPROXY_OPENSEARCH_PORT=9200              # -> node1-5:9200

# --- Bekleme ---
CLUSTER_WAIT_TIMEOUT=1800                 # node1'in diğer 4 node'u bekleme süresi (saniye)
